{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Map",
  "version": "0.1.0",
  "identifier": "com.williamcha.studymap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Study Map",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "backgroundColor": "#0e1116",
        "theme": "Dark"
      },
      {
        "label": "quick",
        "title": "Quick Capture",
        "url": "index.html?quick",
        "width": 580,
        "height": 190,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true,
        "decorations": false,
        "skipTaskbar": true,
        "backgroundColor": "#161b22",
        "theme": "Dark"
      },
      {
        "label": "dig",
        "title": "Dig",
        "url": "index.html?dig",
        "width": 340,
        "height": 72,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true,
        "decorations": false,
        "skipTaskbar": true,
        "backgroundColor": "#161b22",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "copyright": "© 2026 williamcha",
    "shortDescription": "Unknowns as a map, not debt",
    "longDescription": "Capture questions, timebox a dig, and repay with a Check. Notes, images, and papers stay on this computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  }
}
