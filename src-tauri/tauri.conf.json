{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Map",
  "version": "0.1.0",
  "identifier": "com.williamcha.studymap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Study Map",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      },
      {
        "label": "quick",
        "title": "Quick Capture",
        "url": "index.html?quick",
        "width": 580,
        "height": 190,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "center": true,
        "decorations": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
